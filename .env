# Copy to .env and adjust. Never commit a real .env.

# Where per-job folders (SQLite + output.xlsx) are stored. Use a private directory.
APP_DATA_DIR=./.data/jobs
# Matching rules, weights and thresholds.
SCORING_CONFIG_PATH=./config/scoring.toml

# Upload and processing limits for the POC
MAX_UPLOAD_MB=20
MAX_UNCOMPRESSED_MB=200
MAX_ROWS=100000
BATCH_SIZE=200
MAX_CONCURRENT_JOBS=1
JOB_RETENTION_HOURS=24
MAX_ADDRESS_CHARS=500

# Optional comma-separated ISO language codes to force libpostal expansion
# languages (e.g. en,hi). Empty = libpostal language detection.
LIBPOSTAL_LANGUAGES=

LOG_LEVEL=INFO

# Optional LLM for routing free-form follow-up questions. Leave LLM_API_KEY or
# LLM_MODEL empty to use the rule-based router only. Any OpenAI-compatible
# /chat/completions endpoint works (OpenAI, Azure OpenAI proxy, vLLM, ...).
# The LLM receives only the user's question, never address data.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_S=20
